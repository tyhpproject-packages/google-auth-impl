{
    "name": "tyhpdef/google-auth-impl",
    "description": "Implementation package for tyhpdef/google-auth. Require tyhpdef/google-auth, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "1.54.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/psr-cache": "@dev",
                "tyhpdef/psr-log": "@dev",
                "tyhpdef/psr-http-message": "@dev",
                "tyhpdef/guzzlehttp-guzzle": "@dev",
                "tyhpdef/guzzlehttp-psr7": "@dev",
                "tyhpdef/guzzlehttp-promises": "@dev",
                "tyhpdef/firebase-php-jwt": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/google-auth"
        }
    },
    "require": {
        "php": ">=8.2",
        "google/auth": "1.54.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/psr-cache": "@dev",
        "tyhpdef/psr-log": "@dev",
        "tyhpdef/psr-http-message": "@dev",
        "tyhpdef/guzzlehttp-guzzle": "@dev",
        "tyhpdef/guzzlehttp-psr7": "@dev",
        "tyhpdef/guzzlehttp-promises": "@dev",
        "tyhpdef/firebase-php-jwt": "@dev"
    }
}
